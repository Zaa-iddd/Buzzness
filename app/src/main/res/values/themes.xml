<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.POS_App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Default Colors (Gold) -->
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/gold_container</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <!-- System Bar Customizations -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Theme Overlays -->
    <style name="Theme.POS_App.Gold" parent="Base.Theme.POS_App">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryContainer">@color/gold_container</item>
    </style>

    <style name="Theme.POS_App.Blue" parent="Base.Theme.POS_App">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryContainer">@color/blue_container</item>
    </style>

    <style name="Theme.POS_App.Green" parent="Base.Theme.POS_App">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
    </style>

    <style name="Theme.POS_App.Purple" parent="Base.Theme.POS_App">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryContainer">@color/purple_container</item>
    </style>

    <style name="Theme.POS_App" parent="Base.Theme.POS_App" />
</resources>