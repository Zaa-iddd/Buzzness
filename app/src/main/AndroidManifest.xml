<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_buzzness"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_buzzness"
        android:supportsRtl="true"
        android:theme="@style/Theme.POS_App">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AnalysisActivity"
            android:exported="false"
            android:label="Sales Analysis" />
        <activity
            android:name=".InventoryActivity"
            android:exported="false"
            android:label="Inventory Management" />
        <activity
            android:name=".POSActivity"
            android:exported="false"
            android:label="Point of Sale" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="Transaction History" />
        <activity
            android:name=".CalculatorsActivity"
            android:exported="false"
            android:label="Calculators" />
        <activity
            android:name=".TaxCalculatorActivity"
            android:exported="false"
            android:label="Tax Calculator" />
        <activity
            android:name=".CashFlowCalculatorActivity"
            android:exported="false"
            android:label="Cash Flow Calculator" />
        <activity
            android:name=".ROICalculatorActivity"
            android:exported="false"
            android:label="ROI Calculator" />
        <activity
            android:name=".ProfitMarginCalculatorActivity"
            android:exported="false"
            android:label="Profit Margin Calculator" />
        <activity
            android:name=".BreakEvenCalculatorActivity"
            android:exported="false"
            android:label="Break-Even Calculator" />
        <activity
            android:name=".TransactionDetailActivity"
            android:exported="false"
            android:label="Transaction Receipt" />
        <activity
            android:name=".CustomScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />
        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:label="Notifications" />
    </application>

</manifest>
